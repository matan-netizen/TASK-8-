# Optional: enables real AI (Claude) for task analysis and chat.
# Without it, the app runs in a clearly marked deterministic demo mode.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional: where the local JSON database is stored (default: ./data)
DATA_DIR=
# Optional: folder with knowledge-base documents (default: ./knowledge, never committed)
KNOWLEDGE_DIR=
# Security: secret for signing the session cookie (32+ random characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional shared access code required on the login screen (recommended in production)
ACCESS_CODE=
# Optional rate limits (per minute)
AI_RATE_LIMIT_PER_MIN=
LOGIN_RATE_LIMIT_PER_MIN=
